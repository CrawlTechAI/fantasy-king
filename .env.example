# ---------------------------------------------------------------
# Fantasy King settings
#
# HOW TO USE: copy this file, name the copy ".env", and fill in
# the blanks in the copy. The ".env" file stays on your computer
# and is never uploaded. Do NOT put real values in this file.
# ---------------------------------------------------------------

# Where league data comes from.
#   sample    = built-in fake league, for trying the app out
#   manual    = data you paste in from Yahoo (Phase 3)
#   yahoo_api = pulled from the Yahoo Fantasy API (Phase 7)
LEAGUE_DATA_SOURCE=sample

# Which AI service to use.
#   chatgpt    = your ChatGPT plan, via "Sign in with ChatGPT" (no API key)
#   openrouter = your OpenRouter API key (backup; each request costs credits)
# The app never switches between them by itself. To switch, change this line.
AI_PROVIDER=chatgpt

# Model names. The easiest way to fill these in is the AI connection page in
# the dashboard: it loads each service's current list and saves your choice here.
#   CHATGPT_MODEL    = pick after signing in; the list depends on your account
#   OPENROUTER_MODEL = an ID from openrouter.ai/models, such as openai/gpt-5.4-mini
#                      or anthropic/claude-sonnet-5.5 (both in the catalog on
#                      2026-10-01). Do not add ":online"; that suffix is deprecated.
CHATGPT_MODEL=
OPENROUTER_MODEL=

# OpenRouter API key, from openrouter.ai/keys (only needed for AI_PROVIDER=openrouter).
# There is no setting for ChatGPT here on purpose: its sign-in is saved outside
# this folder, encrypted, by the AI connection page.
OPENROUTER_API_KEY=

# Web search for player news. Set to false to never search.
WEB_SEARCH_ENABLED=true
# A limit on searches per AI request, from 0 to 30. 0 means never search.
#   OpenRouter:   sent as the request's tool budget. It is a firm limit for the
#                 search engines OpenRouter runs itself. Some models use their
#                 provider's own built-in search, where the limit may not be
#                 enforced. Each search costs extra credits.
#   ChatGPT plan: OpenAI does not allow a search limit to be sent, so only 0
#                 (never search) has an effect.
MAX_WEB_SEARCHES_PER_RUN=5

# Daily summary email (Phase 5)
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_TO=
EMAIL_APP_PASSWORD=

# Yahoo Fantasy API (Phase 7, after Yahoo approves your application)
YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=
YAHOO_LEAGUE_ID=
